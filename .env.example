# ─────────────────────────────────────────────────────────────────────────────
# AgentMemOS — Environment Configuration
# Copy to .env and fill in your values.
# Never commit the real .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Embeddings ────────────────────────────────────────────────────────────────
# If set, OpenAI text-embedding-3-small is used.
# If not set, falls back to sentence-transformers (local, no API key required).
OPENAI_API_KEY=

# OpenAI model used for memory consolidation synthesis (optional)
# Set to any chat completion model. Defaults to claude-3-5-haiku via API.
SYNTHESISE_MODEL=claude-3-5-haiku-20241022

# ── Pinecone (Tier 1 — Episodic) ──────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX=agentmemos-episodic
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
EMBEDDING_DIM=1536

# ── Redis (Tier 0 — Working) ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
WORKING_MEMORY_TTL=14400

# ── Neo4j (Tier 2 — Semantic) ─────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=agentmemos

# ── PostgreSQL (Tier 3 — Procedural) ──────────────────────────────────────────
POSTGRES_DSN=postgresql://agentmemos:agentmemos@localhost:5432/agentmemos

# ── Kafka (WAL) ───────────────────────────────────────────────────────────────
# Leave blank to run without WAL (degraded mode — writes still succeed)
KAFKA_BROKERS=localhost:9092
KAFKA_WAL_TOPIC=agentmemos.wal

# ── OPA (Federation Policy Engine) ────────────────────────────────────────────
# Leave blank to use local policy evaluation (no OPA sidecar needed)
OPA_URL=http://localhost:8181
OPA_POLICY_PATH=agentmemos/federation/allow

# ── S3 (Cold-tier Archive) ────────────────────────────────────────────────────
S3_ARCHIVE_BUCKET=agentmemos-archive
# AWS credentials are picked up from instance role / env vars automatically

# ── Server ────────────────────────────────────────────────────────────────────
GRPC_PORT=50051
LOG_LEVEL=INFO

# ── Tuning ────────────────────────────────────────────────────────────────────
COLD_CUTOFF_DAYS=30
MIN_IMPORTANCE_HOT=0.35
EMBED_BATCH_SIZE=64
HDBSCAN_MIN_CLUSTER=3
CONSOLIDATION_HOURS=4
WORKING_MAX_ENTRIES=512
